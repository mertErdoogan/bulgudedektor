# PostgreSQL bağlantısı
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/arena"
# Oturum imzası için uzun rastgele değer: `openssl rand -base64 48`
AUTH_SECRET="degistir"
# Sitenin tam adresi (iyzico dönüş adresi, e-posta linkleri, sitemap)
APP_URL="https://www.arenadedektor.com"
# Yüklenen görsellerin klasörü (kalıcı disk olmalı)
UPLOAD_DIR="./uploads"
# iyzico anahtarları admin › Ayarlar › Ödeme'den de girilebilir (orası önceliklidir)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
# Sadece yerel geliştirme: iyzico anahtarı yokken kart ödemesini simüle eder. Canlıda ASLA açmayın.
# PAYMENT_SIMULATION="1"

# ── Canlı ortam ──
# Zamanlanmış işler (/api/cron) için gizli anahtar: `openssl rand -hex 24`
CRON_SECRET=""
# Sunucu hatalarını Slack/Discord/Telegram'a bildirmek için webhook adresi (isteğe bağlı)
ERROR_WEBHOOK_URL=""

# Görsel depolama: boş = yerel disk (UPLOAD_DIR). Vercel gibi sunucusuz ortamda "s3" olmalı (Cloudflare R2 önerilir).
STORAGE_DRIVER=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # R2: https://<hesap-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # ör. https://cdn.arenadedektor.com (bucket'ın herkese açık adresi)

# Cloudflare Turnstile bot koruması (isteğe bağlı; boşsa kapalı)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Docker ile kurulum (docker-compose.yml) ──
DOMAIN="www.arenadedektor.com"
POSTGRES_PASSWORD=""      # `openssl rand -hex 24`
