# PostgreSQL bağlantısı
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/arena"
# Oturum imzası için uzun rastgele değer: `openssl rand -base64 48`
AUTH_SECRET="degistir"
# Sitenin tam adresi (iyzico dönüş adresi, e-posta linkleri, sitemap)
APP_URL="https://www.arenadedektor.com"
# Yüklenen görsellerin klasörü (kalıcı disk olmalı)
UPLOAD_DIR="./uploads"
# iyzico anahtarları admin › Ayarlar › Ödeme'den de girilebilir (orası önceliklidir)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
