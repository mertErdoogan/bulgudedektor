# PostgreSQL bağlantısı
DATABASE_URL="postgresql://kullanici:sifre@localhost:5432/magaza"
# Oturum imzası için uzun rastgele değer: `openssl rand -base64 48`
AUTH_SECRET="degistir"
# Sitenin tam adresi (iyzico dönüş adresi, e-posta linkleri, sitemap)
APP_URL="https://www.magazam.com"
# Yüklenen görsellerin klasörü (kalıcı disk olmalı)
UPLOAD_DIR="./uploads"
# iyzico anahtarları admin › Ayarlar › Ödeme'den de girilebilir (orası önceliklidir)
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
# Sadece yerel geliştirme: iyzico anahtarı yokken kart ödemesini simüle eder. Canlıda ASLA açmayın.
# PAYMENT_SIMULATION="1"

# ── Canlı ortam ──
# Zamanlanmış işler (/api/cron) için gizli anahtar: `openssl rand -hex 24`
CRON_SECRET=""
# Sunucu hatalarını Slack/Discord/Telegram'a bildirmek için webhook adresi (isteğe bağlı)
ERROR_WEBHOOK_URL=""

# Görsel depolama: boş = yerel disk (UPLOAD_DIR). Vercel gibi sunucusuz ortamda "s3" olmalı (Cloudflare R2 önerilir).
STORAGE_DRIVER=""
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""            # R2: https://<hesap-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""          # ör. https://cdn.magazam.com (bucket'ın herkese açık adresi)

# Cloudflare Turnstile bot koruması (isteğe bağlı; boşsa kapalı)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ── Docker ile kurulum (docker-compose.yml) ──
DOMAIN="www.magazam.com"
APEX_DOMAIN=""             # isteğe bağlı: www'ya yönlenecek çıplak alan adı, ör. "magazam.com"
POSTGRES_PASSWORD=""      # `openssl rand -hex 24`

# PayTR (isteğe bağlı; normalde panelden Ayarlar → Ödeme'ye girilir)
# PAYTR_MERCHANT_ID=""
# PAYTR_MERCHANT_KEY=""
# PAYTR_MERCHANT_SALT=""

# Meta Conversions API test: Events Manager → Test olayları kodu (canlıda boş bırakın)
META_TEST_EVENT_CODE=""

# Sunucu dışı gece yedeği (önerilir). Herkese açık OLMAYAN ayrı bir bucket kullanın. Ayrıntı: deploy/backup.sh
BACKUP_S3_BUCKET=""
BACKUP_S3_ENDPOINT=""     # R2: https://<hesap-id>.r2.cloudflarestorage.com
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
# Panelde bu kadar dakika işlem yapılmazsa oturum kapanır (ortak bilgisayar güvenliği)
ADMIN_IDLE_MINUTES="60"
